# NOTHING here is required on Hostinger. Setup, your race, units, refresh
# interval, and the Garmin sign-in are all done in the
# browser (/settings, /login).
#
# These are only for special cases. If set, they're used as starting values.

# TZ=America/Jamaica         # can also be set on the /settings page
# GARMIN_OAUTH1_TOKEN=
# GARMIN_OAUTH2_TOKEN=
# RACE_NAME=
# RACE_DATE=2026-12-31
# UNITS=mi
# REFRESH_MINUTES=10
