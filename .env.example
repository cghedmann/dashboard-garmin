# NOTHING here is required on Hostinger. Each person signs in with their own
# Garmin account on the site and sets up their dashboard on /settings.
#
# Optional:
# DATA_DIR=/home/you/.garmin-dashboard   # where per-user data is kept
# RACE_NAME=, RACE_DATE=2026-12-31, UNITS=mi, REFRESH_MINUTES=10, TZ=
#   (starting values for new users; each person can change their own)
