# Copy these into hPanel -> your Node.js app -> Environment variables.

# Required: from `npm run tokens` on your own computer. Keep secret.
GARMIN_OAUTH1_TOKEN=
GARMIN_OAUTH2_TOKEN=

# Strongly recommended: protects the page with a login prompt.
DASHBOARD_USER=runner
DASHBOARD_PASSWORD=

# Your race and profile (optional; defaults are in dashboard.js).
RACE_NAME=My Marathon
RACE_DATE=2026-12-31
HEIGHT_CM=178
WEIGHT_KG=70
PB_5K=
PB_10K=
PB_HALF=
PB_MARATHON=
UNITS=mi

# Server's clock is UTC; set your timezone so "today" rolls over at your midnight.
TZ=America/Jamaica
REFRESH_MINUTES=60
